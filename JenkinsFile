pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh 'mvn clean test' // Running tests
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml' // Saving test results
                }
                success {
                    echo 'Calculator tests passed successfully!'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker buildx build --load -t calculator-app:${env.BUILD_NUMBER} ."
            }
        }
        stage('Docker Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-hub-credentials') { // pushing to docker hub while hiding credentials from Git by using an environemnt variable
                        sh "docker push your-dockerhub-username/calculator-app:${env.BUILD_NUMBER}"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}